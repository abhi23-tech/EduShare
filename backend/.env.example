# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas for Production)
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/edushare?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/edushare

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Environment Mode (development or production)
NODE_ENV=production
